{
  "schema_version": 1,
  "binary": "m5out/bin/dprh_memmix",
  "windows": {
    "ff_offset": 200000000,
    "warmup": 1000000,
    "measure": 5000000
  },
  "configs": ["B0", "B1", "B2"],
  "gates": {
    "min_speedup_fraction": 0.01,
    "min_speedup_workloads": 2,
    "min_scheduler_delta_workloads": 1,
    "min_ipc_delta_fraction": 0.005,
    "min_row_hit_delta_points": 0.5,
    "min_demand_latency_delta_fraction": 0.005,
    "min_kernel_ipc_span_fraction": 0.01,
    "min_kernel_row_hit_span_points": 1.0
  },
  "workloads": [
    {
      "name": "stream_main",
      "mode": "stream",
      "stream_mib": 64,
      "random_mib": 0,
      "pattern_arg": 4,
      "batches": 2000000000,
      "seed": 1,
      "role": "memory_intensive",
      "suites": ["g0", "full"],
      "held_out": false,
      "expect_prefetch": true,
      "purpose": "Unit-stride, high-coverage and high-row-locality point."
    },
    {
      "name": "stride_main",
      "mode": "stride",
      "stream_mib": 64,
      "random_mib": 0,
      "pattern_arg": 16,
      "batches": 2000000000,
      "seed": 1,
      "role": "memory_intensive",
      "suites": ["g0", "full"],
      "held_out": false,
      "expect_prefetch": true,
      "purpose": "One-KiB stride, prefetchable with lower spatial row density."
    },
    {
      "name": "mix_main",
      "mode": "mix",
      "stream_mib": 64,
      "random_mib": 64,
      "pattern_arg": 4,
      "batches": 2000000000,
      "seed": 1,
      "role": "memory_intensive",
      "suites": ["g0", "full"],
      "held_out": false,
      "expect_prefetch": true,
      "purpose": "Four streaming reads interleaved with one dependent random chase."
    },
    {
      "name": "chase_stress",
      "mode": "chase",
      "stream_mib": 0,
      "random_mib": 64,
      "pattern_arg": 16,
      "batches": 2000000000,
      "seed": 1,
      "role": "stress",
      "suites": ["full"],
      "held_out": false,
      "expect_prefetch": false,
      "purpose": "Serialized randomized pointer cycle with low prefetch coverage."
    },
    {
      "name": "compute_control",
      "mode": "compute",
      "stream_mib": 0,
      "random_mib": 0,
      "pattern_arg": 32,
      "batches": 2000000000,
      "seed": 1,
      "role": "no_harm_control",
      "suites": ["controls", "full"],
      "held_out": false,
      "expect_prefetch": false,
      "purpose": "Compute-bound recurrence with negligible measured DRAM pressure."
    },
    {
      "name": "chase_llc_control",
      "mode": "chase",
      "stream_mib": 0,
      "random_mib": 1,
      "pattern_arg": 16,
      "batches": 2000000000,
      "seed": 1,
      "role": "no_harm_control",
      "suites": ["controls", "full"],
      "held_out": false,
      "expect_prefetch": false,
      "purpose": "Dependent chase whose one-MiB working set fits in the LLC."
    },
    {
      "name": "stride_heldout",
      "mode": "stride",
      "stream_mib": 64,
      "random_mib": 0,
      "pattern_arg": 7,
      "batches": 2000000000,
      "seed": 17,
      "role": "memory_intensive",
      "suites": ["held_out"],
      "held_out": true,
      "expect_prefetch": true,
      "purpose": "Reserved non-power-of-two stride; never used for tuning."
    },
    {
      "name": "mix_heldout",
      "mode": "mix",
      "stream_mib": 64,
      "random_mib": 64,
      "pattern_arg": 8,
      "batches": 2000000000,
      "seed": 17,
      "role": "memory_intensive",
      "suites": ["held_out"],
      "held_out": true,
      "expect_prefetch": true,
      "purpose": "Reserved stream-to-chase ratio and seed; never used for tuning."
    }
  ]
}
